{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daedalus/schemas/message.schema.json",
  "type": "object",
  "required": [
    "messageId",
    "role",
    "parts"
  ],
  "properties": {
    "messageId": {
      "type": "string",
      "minLength": 1
    },
    "contextId": {
      "type": "string"
    },
    "taskId": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "user",
        "agent"
      ]
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "mediaType": {
            "type": "string"
          },
          "metadata": {
            "type": "object"
          },
          "data": {}
        }
      }
    },
    "metadata": {
      "type": "object"
    }
  }
}
