{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-forge/schemas/task.schema.json",
  "type": "object",
  "required": ["id", "status"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "contextId": {
      "type": "string"
    },
    "status": {
      "type": "object",
      "required": ["state"],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "submitted",
            "working",
            "completed",
            "failed",
            "canceled",
            "input-required",
            "rejected"
          ]
        },
        "message": {
          "$ref": "message.schema.json"
        },
        "timestamp": {
          "type": "string"
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifactId", "parts"],
        "properties": {
          "artifactId": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "parts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object"
            }
          },
          "metadata": {
            "type": "object"
          }
        }
      }
    },
    "history": {
      "type": "array",
      "items": {
        "$ref": "message.schema.json"
      }
    },
    "metadata": {
      "type": "object"
    }
  }
}
