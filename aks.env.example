# aks.env.example - copy to aks.env and fill in for `make test-aks-e2e`.
# aks.env is gitignored and must never be committed.
#
# Pre-conditions before running the test:
#   1. `make deploy-aks-test` has succeeded (Phase 5.3 provisions the cluster
#      and installs the Daedalus Helm release).
#   2. kubectl is pointing at the AKS cluster and the context name is set
#      below in KUBE_CONTEXT.
#   3. NATS is reachable at NATS_URL. The typical local pattern is to
#      port-forward the in-cluster service to localhost first:
#
#          kubectl port-forward -n daedalus svc/daedalus-nats 4222:4222 &
#
#      then leave NATS_URL=nats://localhost:4222 below.

# --- Required ---

# NATS endpoint reachable from the test process. Use the port-forward URL
# (above) for local runs, or a LoadBalancer IP/hostname if exposed.
NATS_URL=nats://localhost:4222

# kubectl context that points at the AKS cluster under test. The Makefile
# target sources this file before invoking go test, and every kubectl/helm
# call in the test passes --context=$KUBE_CONTEXT explicitly.
KUBE_CONTEXT=

# --- Optional (defaults shown) ---

# Kubernetes namespace the Helm release is installed into.
NAMESPACE=daedalus

# Helm release name to validate via `helm status`.
RELEASE_NAME=daedalus

# Total wait budget for one task round-trip. Go duration string.
TASK_TIMEOUT=10m

# When non-empty, the test logs that the cluster should be preserved on
# success. The test never destroys the cluster itself; cleanup is the
# operator's job (`make destroy-aks-test`).
KEEP_CLUSTER=

# Azure resource group name, logged on test exit so the operator can
# locate the cluster for manual cleanup or TTL extension.
RESOURCE_GROUP=

# ISO-8601 timestamp matching the cluster's `expires-at` resource-group tag
# (set by the Phase 5.1 Terraform module / Phase 5.3 deploy script). This is
# used PURELY for log output on test exit so the operator can see when the
# cluster will be auto-destroyed; the test never reads it for any control
# flow. Leave empty if you don't have it handy.
EXPIRES_AT=
