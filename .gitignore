# Local credentials - never commit
smoke.env
*.env.local
.env.local

# Test artifacts
coverage.out
*.test

# IDE
.idea/
.vscode/
*.swp
*~

# Terraform (deploy/terraform)
# Note: .terraform.lock.hcl IS committed for reproducibility - do NOT ignore it.
deploy/terraform/**/*.tfstate
deploy/terraform/**/*.tfstate.*
deploy/terraform/.terraform/
deploy/terraform/**/.terraform/
deploy/terraform/**/*.tfvars
!deploy/terraform/envs/*.tfvars.example
deploy/terraform/crash.log
deploy/terraform/crash.*.log

# Terraform override files (escape hatch - should never be committed)
deploy/terraform/override.tf
deploy/terraform/override.tf.json
deploy/terraform/**/*_override.tf
deploy/terraform/**/*_override.tf.json
