# Copilot CLI in ACP server mode.
# Runs headless, accepting JSON-RPC over TCP on the specified port.
#
# The exact npm package name for Copilot CLI may vary between releases.
# The entrypoint script auto-detects the installed binary name.
FROM node:22-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl ca-certificates netcat-openbsd && \
    rm -rf /var/lib/apt/lists/*

# Install GitHub Copilot CLI globally.
# Try the most likely package names; at least one should succeed.
RUN npm install -g @github/copilot-cli || \
    npm install -g github-copilot-cli || \
    echo "WARN: Copilot CLI package name may vary - check npm registry"

# Non-root user for security
RUN groupadd -r copilot && useradd -r -g copilot -m copilot

# Copy entrypoint before switching to non-root user
COPY --chmod=755 deploy/docker/copilot-entrypoint.sh /usr/local/bin/copilot-entrypoint.sh

USER copilot

WORKDIR /workspace

EXPOSE 3000

ENTRYPOINT ["copilot-entrypoint.sh"]
CMD ["--port", "3000"]
