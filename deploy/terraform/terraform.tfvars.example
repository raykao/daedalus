# Copy to terraform.tfvars and fill in values
# Do NOT commit terraform.tfvars to source control

location            = "eastus2"
resource_group_name = "rg-daedalus-test"
cluster_name        = "aks-daedalus-test"
# Check supported versions: https://learn.microsoft.com/azure/aks/supported-kubernetes-versions
kubernetes_version  = "1.30"
node_vm_size        = "Standard_D2s_v3"
node_count          = 2
acr_name            = "" # Leave empty for auto-generated name

keda_chart_version = "2.15.1"

tags = {
  project     = "daedalus"
  environment = "test"
  managed_by  = "terraform"
  owner       = "your-team"
}
