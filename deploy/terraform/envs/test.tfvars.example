subscription_id = "00000000-0000-0000-0000-000000000000"
env_name        = "test"
region          = "eastus"
name_prefix     = "daedalus"
node_count      = 2
node_vm_size    = "Standard_D2s_v5"
ttl_hours       = 4

# GitHub repo whose Actions runs are allowed to assume the GHA managed
# identity via OIDC. Defaults to raykao/daedalus; override only if you fork.
# github_owner = "raykao"
# github_repo  = "daedalus"

# Override the federated credential subjects. Empty list (the default)
# expands to:
#   repo:<github_owner>/<github_repo>:ref:refs/heads/main
#   repo:<github_owner>/<github_repo>:pull_request
#   repo:<github_owner>/<github_repo>:environment:test
# github_oidc_subjects = []

# Phase 5.5 TTL cleanup. Default true grants the GHA UAMI sub-scoped
# Contributor so the nightly-cleanup workflow can delete expired RGs.
# Set to false to disable - the workflow will run but be unable to delete.
# enable_cleanup_role = true

tags = {
  project    = "daedalus"
  phase      = "5"
  managed_by = "terraform"
}
